# ============================================================================
# .env.example — توثيق كل متغيرات البيئة التي يستخدمها المشروع فعلياً
# انسخ هذا الملف إلى .env وضع القيم الحقيقية هناك (.env لا يُرفع إلى Git أبداً).
# على Render: تُوضع نفس المتغيرات في Dashboard → Environment (وليس ملفات).
# ============================================================================

# ---------------------------------------------------------------------------
# 1) أساسيات النشر (إلزامية على Render)
# ---------------------------------------------------------------------------

# NODE_ENV: بدونها يعمل الخادم بوضع Vite التطويري بدل خدمة dist/ المبنية.
# على Render: ضعها production (موجودة في render.yaml).
NODE_ENV=production

# PUBLIC_BASE_URL: الرابط العام للمنصة — تُبنى عليه روابط دعوات البريد
# مثال: https://analytics-platform.onrender.com
PUBLIC_BASE_URL=https://your-app.onrender.com

# PORT: يحقنه Render تلقائياً — لا تضعه هناك. محلياً الافتراضي 3000.
# PORT=3000

# ---------------------------------------------------------------------------
# 2) البريد — مطلوب مزوّد واحد على الأقل لدعوات المجموعات
#    الترتيب التلقائي: Brevo API → Resend API → SMTP (انظر 3)
# ---------------------------------------------------------------------------

# BREVO_API_KEY: الأنسب للبدء — مجاني 300 رسالة/يوم ويعمل على Render المجاني
# (SMTP الصادر محظور هناك). أنشئه من brevo.com → SMTP & API → API Keys
# BREVO_API_KEY=xkeysib-xxxxxxxx

# RESEND_API_KEY: بديل اختياري — يتطلب نطاق إرسال مُتحققاً
# RESEND_API_KEY=re_xxxxxxxx

# SMTP_FROM: مُرسِل الرسائل بصيغة "الاسم <بريد>" أو بريد فقط.
# يحدد المُرسِل في مساري Brevo وResend أيضاً — يجب أن يطابق مُرسِلاً متحققاً.
SMTP_FROM="منصة تحليل البيانات <you@example.com>"

# ---------------------------------------------------------------------------
# 3) SMTP الاحتياطي (اختياري — يعمل على VPS/Oracle فقط؛ Render يحظر SMTP)
# ---------------------------------------------------------------------------

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true

# SMTP_USER: بريد Gmail المُرسِل
# SMTP_USER=you@gmail.com

# SMTP_PASS: App Password مكوّن من 16 حرفاً (ليس كلمة مرور الحساب!)
# أنشئه من https://myaccount.google.com/apppasswords
# SMTP_PASS=xxxxxxxxxxxxxxxx

# ---------------------------------------------------------------------------
# 4) الذكاء الاصطناعي (اختيارية على الخادم)
#    كل مستخدم يستطيع إدخال مفتاحه الخاص من صفحة إعدادات النماذج (يُخزن
#    محلياً في متصفحه وله الأولوية). مفاتيح الخادم هنا تعمل كافتراضي جماعي.
# ---------------------------------------------------------------------------

# GEMINI_API_KEY: افتراضي Gemini — من https://aistudio.google.com/apikey
# GEMINI_API_KEY=

# مزوّدون بديلون (اختيارية) — أي مفتاح حقيقي هنا يصبح افتراضياً جماعياً يخدم كل المستخدمين
# OPENROUTER_API_KEY=
# DEEPSEEK_API_KEY=
# QWEN_API_KEY=

# نقطة نهاية OpenAI مخصصة (اختيارية — endpoint متوافق + مفتاحه)
# CUSTOM_OPENAI_ENDPOINT=https://your-endpoint/v1
# CUSTOM_OPENAI_API_KEY=

# حد يومي لكل مستخدم على استخدام مفاتيح الخادم أعلاه (يحمي الرصيد المشترك)
# AI_SERVER_DAILY_LIMIT=100        # طلب/يوم لكل مستخدم عادي
# AI_SERVER_ADMIN_DAILY_LIMIT=0    # 0 = المدير غير محدود

# حفظ مجموعات البيانات المستوردة في SQLite على الخادم (تبقى بعد تحديث الصفحة)
# DATASET_SERVER_LIMIT_MB=10       # الحد الأقصى لحجم المجموعة الواحدة بالميغابايت (افتراضي 10)

# حفظ لوحات التحكم وحالة مساحة العمل (تقارير/قصص/جداول تحديث) خادمياً لكل مستخدم — خصوصية كاملة
# WORKSPACE_STATE_LIMIT_MB=5       # الحد الأقصى لحجم اللوحة الواحدة أو نوع حالة واحد بالميغابايت (افتراضي 5)

# ---------------------------------------------------------------------------
# 5) تطوير محلي فقط (لا تضعها على Render)
# ---------------------------------------------------------------------------

# DISABLE_HMR: تعطيل HMR أثناء تعديلات الوكيل لتجنب الوميض (AI Studio)
# DISABLE_HMR=true
